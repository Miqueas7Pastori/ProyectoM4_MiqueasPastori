# Copiá este archivo a .env y completá los valores.
# .env no se commitea.

# Firebase. Estas variables las lee el frontend (prefijo VITE_).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Servidor (función /api en Vercel y en el dev server). Sin prefijo VITE_.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_SES_FROM_EMAIL=

# Mismo id que VITE_FIREBASE_PROJECT_ID. Sirve para comprobar el token en el servidor.
FIREBASE_PROJECT_ID=
